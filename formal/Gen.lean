import FriendoTube
/-! `lake exe gen <repo root>` writes the JS copies of `FriendoTube/Limits.lean`. CI regenerates
them and fails on any diff, so the JS bounds and id check are always the proven ones. -/
open FriendoTube

/-- Regex character class for `idAlphabet`: every character listed, `-` escaped. -/
def charClass : String :=
  idAlphabet.foldl (fun acc c => acc ++ (if c == '-' || c == '\\' || c == ']' || c == '^' then "\\" ++ c.toString else c.toString)) ""

def header (lang : String) : String :=
  s!"{lang} GENERATED by `lake exe gen` from formal/FriendoTube/Limits.lean. Do not edit: CI fails if this drifts.\n"

def body (prefix_ : String) (eq : String) (sep : String) : String :=
  String.intercalate sep [
    s!"{prefix_}MAX_NAME{eq}{maxName}", s!"{prefix_}MAX_GROUP_NAME{eq}{maxGroupName}",
    s!"{prefix_}MAX_TITLE{eq}{maxTitle}", s!"{prefix_}MAX_CHANNEL{eq}{maxChannel}",
    s!"{prefix_}MAX_NOTE{eq}{maxNote}", s!"{prefix_}MAX_CODE{eq}{maxCode}",
    s!"{prefix_}MAX_VIDEOS{eq}{maxVideos}", s!"{prefix_}MAX_SHELF{eq}{maxShelf}",
    s!"{prefix_}UNTITLED{eq}\"{String.ofList untitled}\"",
    s!"{prefix_}VIDEO_ID{eq}/^[{charClass}]\{{videoIdLength}}$/"]

def serverJs : String := header "//" ++ body "export const " " = " ";\n" ++ ";\n"
def extensionJs : String :=
  header "//" ++ "globalThis.FT_LIMITS = Object.freeze({\n" ++ body "  " ": " ",\n" ++ ",\n});\n"

def main (args : List String) : IO Unit := do
  let root := args.headD ".."
  IO.FS.writeFile s!"{root}/server/limits.gen.mjs" serverJs
  IO.FS.writeFile s!"{root}/extension/limits.gen.js" extensionJs
  IO.println "wrote server/limits.gen.mjs and extension/limits.gen.js"
